# Keep the build context small and reproducible. The generated sample data in
# lib/sick-leave/ is checked in and IS needed for the build, so it is not ignored.
node_modules
.next
.git
.github
.gitignore

# Unrelated to the Next app build. model/ is NOT excluded wholesale: the
# absenteeism agent route imports model/welo_inference/agent_prompts.json, the
# shared source of truth for the agent prompts. Only the heavy artifacts under
# it are dropped.
model/models
model/data
model/tests
model/reports
model/welo_pipeline

# ...except the feed files the prebuild scripts read to generate the module
# data and stage the standalone dashboard. Excluding model/data wholesale was
# correct when it held only training artifacts; it silently broke the image
# build once scripts/build-absence-module-data.mjs and
# build-control-centre-data.mjs started reading from it, because `npm run
# build` runs prebuild first and prebuild cannot find its input.
#
# Named one by one rather than un-ignoring model/data/outputs, so the CSVs
# beside them (predictions, the synthetic upload extract) stay out of the
# image. Those are data about people, even synthetic people, and an image
# layer is forever.
!model/data/outputs/dashboard_feed.json
!model/data/outputs/dashboard_feed.js
!model/data/outputs/dashboard_feed.manufacturing.js
!model/data/outputs/dashboard_feed.logistics.js
!model/data/outputs/cohort_series.json
infra
docs
README.md

# Local env / editor noise
.env
.env.*
.DS_Store
.vscode
.idea
