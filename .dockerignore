# Keep the build context small and reproducible. The generated sample data in
# lib/sick-leave/ is checked in and IS needed for the build, so it is not ignored.
node_modules
.next
.git
.github
.gitignore

# Unrelated to the Next app build. model/ is NOT excluded wholesale: the
# absenteeism agent route imports model/welo_inference/agent_prompts.json, the
# shared source of truth for the agent prompts. Only the heavy artifacts under
# it are dropped.
model/models
model/data
model/tests
model/reports
model/welo_pipeline
infra
docs
README.md

# Local env / editor noise
.env
.env.*
.DS_Store
.vscode
.idea
