# Copy to demo.tfvars and edit. One file per environment: keep a separate
# client.tfvars for the client's project when you migrate.
#
#   terraform apply -var-file=demo.tfvars

project_id = "my-demo-project"
region     = "europe-west1"

# Prefix for every tenant bucket. Bucket names are global across all of GCS, so
# there is no default: choose something that identifies this deployment.
bucket_prefix = "welo-CHANGE-ME"

# --- Tenants ---
# The platform's unit of isolation. Each entry gets its own landing and derived
# buckets, its own pseudonymisation key, its own service accounts, and
# optionally its own ingest job and application instance. Adding a client is
# adding an entry here. The key is permanent: changing it replaces everything
# belonging to that tenant.
#
# deploy_platform = false leaves the application on Vercel; the tenant's
# environment still comes out of this config, as `terraform output
# tenant_platform_env`.
tenants = {
  demo = {
    display_name = "Demo tenant"
    environment  = "demo"
    synthetic    = true
    # enable_agents   = true    # wire the shared Anthropic key into this tenant
    # deploy_ingest   = true    # needs ingest_image
    # deploy_platform = true    # needs platform_image; otherwise Vercel
  }

  # A real client, for shape. suppression_threshold may be raised but never
  # lowered below five, and synthetic = false removes the demo marking.
  # glencore = {
  #   display_name          = "Glencore South Africa"
  #   environment           = "production"
  #   synthetic             = false
  #   suppression_threshold = 10
  #   region                = "africa-south1"
  #   modules               = { absence = true, sick_leave = false, control_centre = false }
  #   allow_unauthenticated = false
  #   deploy_ingest         = true
  #   ingest_image          = "europe-west1-docker.pkg.dev/my-demo-project/welo/welo-ingest:latest"
  #   labels                = { cost-centre = "mining-sa" }
  # }
}

# Build the image first with infra/scripts/build_and_push.sh, then paste its ref:
image = "europe-west1-docker.pkg.dev/my-demo-project/welo/welo-inference:latest"

# --- Sick Leave dashboard (Next.js) ---
# The sick-leave dashboard is hosted on Vercel, so it is NOT deployed here.
# Set this true only to run it on Cloud Run as well (for example to keep it
# inside the client's project); you must then build its image with
# build_and_push_sick_leave.sh and set sick_leave_image.
deploy_sick_leave = false
# sick_leave_image         = "europe-west1-docker.pkg.dev/my-demo-project/welo/welo-sick-leave:latest"
# sick_leave_enable_agents = false
# sick_leave_agent_model   = "claude-sonnet-5"

# --- Dashboard static hosting (optional) ---
host_dashboard   = true
dashboard_bucket = "welo-dashboard-demo-CHANGE-ME-unique" # globally unique
dashboard_public = true

# --- Agents ---
# Where the agents call Claude:
#   "anthropic" (default): first-party Anthropic API with a key from Secret
#     Manager. Right for the public demo.
#   "vertex": Claude on Google Vertex AI, authenticated as the runtime service
#     account (no key, data stays in the chosen Google region). Preferred for
#     Welo's own project. Terraform then grants the SA roles/aiplatform.user and
#     sets WELO_VERTEX_PROJECT / WELO_VERTEX_REGION for you; ignore the key
#     handling section below.
llm_provider = "anthropic"
# vertex_region = "us-east5"   # only when llm_provider = "vertex"

# First deploy: leave false (the what-if panel still works). On the anthropic
# path, add the key to the secret, then set true and re-apply to switch the
# agents on. On the vertex path, set true once the SA has Vertex access.
enable_agents = false
agent_model   = "claude-opus-4-8"

# --- Security ---
allow_unauthenticated = true
cors_origins          = ["*"] # lock to the dashboard origin for a real deploy

# --- Key handling ---
# Recommended: leave false and add the key via gcloud (see outputs.add_key_command)
# so it never lands in Terraform state.
create_secret_version = false
# anthropic_api_key   = "sk-ant-..."   # only if create_secret_version = true
