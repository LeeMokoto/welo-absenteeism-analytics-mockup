# Variables for the absenteeism-demo project.
#
# Copy to demo.tfvars and adjust. demo.tfvars is gitignored; this example is
# tracked, so keep anything secret out of both.
#
#   cp demo.tfvars.example demo.tfvars
#   terraform apply -var-file=demo.tfvars
#
# Pre-filled for the demo project. One file per environment: keep a separate
# client.tfvars for a client project when you migrate.

project_id = "absenteeism-demo"

# africa-south1 (Johannesburg) keeps the demo in country, which is the point
# when showing it to a South African client. It is a tier 2 region, about 40
# percent more per vCPU-second and GiB-second than europe-west1, which on these
# volumes is roughly USD 10 a year. Switch to europe-west1 if you would rather
# have the cheaper tier and do not need the residency story.
#
# Bucket location is immutable: changing this after the first apply replaces
# every bucket, so decide before you run it rather than after.
region = "africa-south1"

# Prefix for tenant bucket names, which are global across all of GCS. Buckets
# become welo-ad-demo-raw and welo-ad-demo-derived. If the apply fails with
# "bucket already exists", someone else has taken the name: change this.
bucket_prefix = "welo-ad"

# Build the image first with infra/scripts/build_and_push.sh, then paste its ref
# here. infra/scripts/provision_demo.sh does this for you.
image = "africa-south1-docker.pkg.dev/absenteeism-demo/welo/welo-inference:latest"

# --- Tenants ---
# One demo tenant. Adding a client is adding an entry here; the key is
# permanent, since changing it replaces everything belonging to that tenant.
#
# deploy_platform stays false: the platform runs on Vercel today, and the
# tenant's environment still comes out of this config as
# `terraform output tenant_platform_env` for you to set there. Turning it true
# also runs the Next.js app on Cloud Run, which costs about USD 14 a month more
# and is worth doing when you want to show the whole stack inside GCP.
tenants = {
  demo = {
    display_name = "Demo tenant"
    environment  = "demo"
    synthetic    = true

    # Switch on once the Anthropic key is in Secret Manager. Until then the
    # application renders with the agent panels showing a disabled state.
    enable_agents = false

    # Needs an ingest image, which does not exist yet. The buckets, the
    # pseudonymisation key and the service accounts are created either way, so
    # the signed-URL upload target works before the processor does.
    deploy_ingest   = false
    deploy_platform = false
  }
}

# --- Dashboard static hosting ---
# The standalone absenteeism dashboard is already served from Vercel, so this is
# off. Turn it on to serve it from GCS as well; dashboard_bucket must then be
# globally unique.
host_dashboard   = false
dashboard_bucket = ""

# --- Agents ---
# "anthropic" uses the first-party API with a key from Secret Manager, which is
# right for a demo and is what Vercel already uses. "vertex" authenticates as
# the runtime service account with no key, but Claude is not served from
# africa-south1, so a vertex deployment has to name a region elsewhere and the
# call leaves the country. See docs/data-governance.md.
llm_provider = "anthropic"

# First apply: leave false. Add the key to the secret, then set true and
# re-apply. infra/scripts/provision_demo.sh walks this.
enable_agents = false
agent_model   = "claude-opus-4-8"

# --- Security ---
# Public for a demo. For anything with real data this becomes false and access
# goes through the identity provider instead.
allow_unauthenticated = true
cors_origins          = ["*"]

# --- Key handling ---
# Leave false and add the key with gcloud, so it never lands in Terraform state.
create_secret_version = false

# --- Security monitoring ---
# Audit logging, a retained security log bucket and the detections in
# modules/security-monitoring. Eleven are live against a project shaped like
# this one: IAM changes, service account key creation, a Cloud Run service or a
# bucket being opened to the internet, a person reading a secret payload, audit
# or logging configuration being changed, and a spike in refused requests.
#
# Put at least one address here. Without it the detections are created and
# nobody is told, which looks like coverage and is not; `terraform output
# security_notifies` says so in as many words.
security_alert_emails = ["you@cloudsmiths.co.za"] # CHANGE ME
security_alert_label  = "demo"

# The inference service is intentionally public for the demo, so it is excluded
# from the "opened to the internet" detection automatically (see main.tf). Any
# other service becoming public still alerts.

# --- Billing budget ---
# Expected spend for this demo is single digits a month with nothing kept warm.
# A budget of 50 alerts long before anything is wasted and well before the
# cpu_idle mistake (about USD 190 a month if both services are flipped) could
# run for long.
#
# Fill in the billing account to switch it on:
#   gcloud billing projects describe absenteeism-demo \
#     --format='value(billingAccountName)'
# billing_account = "012345-67890A-BCDEF0"
budget_amount   = 50
budget_currency = "USD"

# --- CI identity (optional) ---
# Keyless CI authentication through Workload Identity Federation. Set this to
# let GitHub Actions plan against the project with no service account key.
# ci_github_repository = "LeeMokoto/welo-absenteeism-analytics-mockup"
# ci_state_bucket      = "welo-ad-tfstate"
